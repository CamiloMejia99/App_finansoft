@model IEnumerable<FNTC.Finansoft.Accounting.DTO.MCreditos.GarantiasCreditos>

@{
    ViewBag.Title = "Garantías Registradas";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="jumbotron">
                <h2>Bienvenido al Sistema de Garantías</h2>
                <p>Aquí podrá visualizar y gestionar todas las garantías registradas para el préstamo.</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4>Garantías Registradas para el Préstamo @ViewBag.Pagare</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Garantía</th>
                                <th>Valor Real</th>
                                <th>Codeudor</th>
                                <th>Valor Crédito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.garantia_id</td>
                                    <td>@item.Real_Valor.ToString("N2")</td>
                                    <td>@item.nombre_codeudor</td>
                                    <td>@item.valor_credito.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <a href="@Url.Action("Create", "Prestamos")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Agregar Nueva Garantía
            </a>
            <a href="@Url.Action("Index", "Prestamos")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Volver a Préstamos
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Auto-hide success message after 5 seconds
            setTimeout(function () {
                $('.alert-success').fadeOut('slow');
            }, 5000);
        });
    </script>
} 